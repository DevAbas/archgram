    { "id": "ci", "kind": "service", "label": "CI job", "note": "optional", "tech": "githubactions" },
    { "id": "adapters", "kind": "script", "label": ".claude/hooks/design-system", "note": "only translate", "frame": "claude" },
    { "id": "precommit", "kind": "script", "label": "pre-commit", "note": "git hook" },
    { "id": "core", "kind": "script", "label": "harness/gates.mjs", "note": "every decision", "frame": "ds" },
    { "id": "gates", "kind": "file", "label": "gates.json", "note": "what runs, and when", "frame": "ds" },
    { "id": "checks", "kind": "check", "label": "checks/", "note": "tokens and rules contract", "frame": "ds" },
