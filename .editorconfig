# Editors write every file the same way: UTF-8, LF, a final newline, spaces.
# rustfmt owns Rust's formatting (rustfmt.toml); this is for everything else.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,md}]
indent_size = 2
